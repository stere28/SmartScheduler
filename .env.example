# ──────────────────────────────────────────────────────────────────────────────
# SmartScheduler – Environment Configuration Template
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# LLM Provider: "ollama" (default, free, local) or "openai" (requires API key)
LLM_PROVIDER=ollama

# Model name
#   Ollama examples: llama3.2, llama3.1:8b, mistral, qwen2.5:7b
#   OpenAI examples: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
LLM_MODEL=llama3.2

# LLM temperature (0.0 = deterministic, 1.0 = creative). Recommended: 0.2
LLM_TEMPERATURE=0.2

# Ollama server URL
# Docker Compose : http://ollama:11434
# Local dev      : http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API key (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
